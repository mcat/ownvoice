{
  "name": "ownvoice",
  "version": "0.1.0",
  "description": "In-patient AAC web application with on-device voice cloning",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/strip-dist-large.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:audit": "stryker run stryker.audit.config.json",
    "manifest:regen": "node scripts/regenerate-manifest.mjs",
    "manifest:check": "node scripts/regenerate-manifest.mjs --check",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "assets:download": "./scripts/download-assets.sh",
    "assets:upload": "node scripts/upload-r2-assets.mjs",
    "assets:prune": "node scripts/prune-r2.mjs",
    "assets:prune:dry": "node scripts/prune-r2.mjs --dry-run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/virtual-core": "^3.17.6",
    "markdown-to-jsx": "^7.7.17",
    "onnxruntime-web": "^1.25.1",
    "preact": "^10.29.7",
    "preact-iso": "^2.12.1",
    "superjson": "^2.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@cloudflare/workers-types": "^4.20260518.1",
    "@preact/preset-vite": "^2.10.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.27.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0"
  }
}
