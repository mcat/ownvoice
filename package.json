{
  "name": "ownvoice",
  "version": "0.1.0",
  "description": "In-patient AAC web application with on-device voice cloning",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/strip-dist-large.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "manifest:regen": "node scripts/regenerate-manifest.mjs",
    "manifest:check": "node scripts/regenerate-manifest.mjs --check",
    "assets:download": "./scripts/download-assets.sh",
    "assets:upload": "node scripts/upload-r2-assets.mjs",
    "assets:prune": "node scripts/prune-r2.mjs",
    "assets:prune:dry": "node scripts/prune-r2.mjs --dry-run"
  },
  "dependencies": {
    "markdown-to-jsx": "^7.7.17",
    "onnxruntime-web": "^1.25.1",
    "preact": "^10.29.1",
    "preact-iso": "^2.11.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@preact/preset-vite": "^2.10.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "onnxruntime-node": "^1.25.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0"
  }
}
