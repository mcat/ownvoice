# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Vite
.vite/

# Test output
coverage/

# Stryker mutation-testing output
reports/
.stryker-tmp/
stryker-*.log

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Dev-only browser-log mirror — see src/dev/logSink.ts + the
# logSinkPlugin in vite.config.ts. Truncated on every `npm run dev`.
logs/

# Local mkcert dev certs — generated per-machine, never commit
certs/

# Environment — never commit secrets
.env
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.iml
*.local
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Large asset files — too big for git. Download with: npm run assets:download
# (see scripts/download-assets.sh)
public/models/
# ORT versioned dir: ignore the large .wasm bytes only; keep the small .mjs
# glue tracked so a fresh checkout has the JS shims without downloading.
public/ort/v*/*.wasm

# Pipeline-verify script outputs — regenerated on each run
scripts/pipeline-verify/*.wav

# Python bytecode
__pycache__/
*.pyc

# fp16-conversion virtualenv (created by download-assets.sh on first run
# to convert the speech_encoder from fp32 → fp16 — see scripts/convert-encoder-fp16.py)
.venv-fp16/

.superpowers/

# Worktrees for isolated multi-branch development
.worktrees/

# Local-only Claude harness extras (skill bundles installed per-machine,
# working notes, reference PDFs). These are not project source and must
# never be committed — `git add -A` would otherwise sweep them in.
#
# Skills are opt-in per skill: ignore the directory contents, then negate the
# handful we deliberately share with collaborators. Note the `/*` — a bare
# `.claude/skills/` excludes the directory itself and git will not descend
# into it, so no `!` negation below it can ever match.
.claude/skills/*
!.claude/skills/a11y/
!.claude/skills/mutation-audit/
!.claude/skills/claude-for-safari/
!.claude/skills/ownvoice-logsink/
!.claude/skills/voice-quality-recalibration/
.claude/*.lock
aac-icu-candidacy.md
# sample-voices/ is gitignored except for the calibration fixture used by
# voiceQuality.test.ts. Leave the directory rule in place; negate only the
# fixture and its README.
sample-voices/*
!sample-voices/mark-voice.wav
!sample-voices/README.md
docs/*.pdf

.agents
AGENTS.md
.codex
