/sw.js
  Service-Worker-Allowed: /app/

/app/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Workers loaded into the crossOriginIsolated /app/* context need their own
# COEP header on the script response — without it the browser refuses to
# instantiate the worker (DevTools: "Cross-Origin-Embedder-Policy: NOT-SET").
# `credentialless` matches the parent page; CORP same-origin keeps the
# scripts un-embeddable cross-origin.
#
# EXPERIMENT for issue #127: the previous `Cache-Control: no-cache` was
# silently dropped by CF Pages on these static-asset paths (the COEP/CORP
# headers from the same block applied correctly). Trying the semantically
# equivalent `public, max-age=0, must-revalidate` form to learn whether
# the bug is specific to the `no-cache` token or whether CF Pages drops
# all Cache-Control overrides on static assets. Result will be recorded
# in #127.
#
# Both values mean "may cache, must revalidate before each use" per
# RFC 9111. Response bodies are cacheable; freshness check is mandatory.
# This means future header-only changes (e.g., tighter COEP) propagate
# on the next reload instead of being shadowed by stale edge entries
# that 304 against a byte-identical origin response.
/tts-gpu-worker.js
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

/stt-gpu-worker.js
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Vite emits the bundled WASM workers (ttsWorker, sttWorker, llmWorker) under
# /assets/. Same COEP requirement as the GPU workers when loaded from /app/.
/assets/*
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

/ort/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable
