/sw.js
  Service-Worker-Allowed: /app/

# DISCRIMINATOR EXPERIMENT (branch experiment/coep-off-discriminator):
# COEP/COOP intentionally removed to test whether the "access control checks"
# console errors on manual nav-bar refresh are caused by COEP enforcement.
# If errors persist on this preview, COEP is not the cause and the
# drop-SAB fix is invalid. If errors are gone, drop-SAB is confirmed.
# Subsequent CORP entries are kept harmless — CORP without COEP is a no-op.
#
# DO NOT MERGE THIS BRANCH. It disables crossOriginIsolated entirely,
# which silently degrades ORT to single-threaded WASM.

/tts-gpu-worker.js
  Cross-Origin-Resource-Policy: same-origin

/stt-gpu-worker.js
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cross-Origin-Resource-Policy: same-origin

/ort/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

/models/*
  Cache-Control: public, max-age=31536000, immutable

/models-manifest.json
  Cross-Origin-Resource-Policy: same-origin
/manifest.webmanifest
  Cross-Origin-Resource-Policy: same-origin
/icons/*
  Cross-Origin-Resource-Policy: same-origin
/splash/*
  Cross-Origin-Resource-Policy: same-origin
