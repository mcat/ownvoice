{
  "name": "OwnVoice",
  "short_name": "OwnVoice",
  "description": "In-patient AAC with personal voice",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FAFAF8",
  "theme_color": "#FAFAF8",
  "categories": ["medical", "health", "accessibility"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pain scale",
      "short_name": "Pain",
      "description": "Open the validated Emoji-FPS pain scale",
      "url": "/app/?tab=pain",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Wishes",
      "short_name": "Wishes",
      "description": "Open the goals-of-care conversation overlay",
      "url": "/app/?overlay=wishes",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Listen",
      "short_name": "Listen",
      "description": "Transcribe what the provider is saying",
      "url": "/app/?overlay=listen",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Provider mode",
      "short_name": "Provider",
      "description": "Open the clinician-facing surfaces",
      "url": "/app/?overlay=provider",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
